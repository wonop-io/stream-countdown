{
  "id": "stream-countdown",
  "apiVersion": 1,
  "name": "Stream Countdown",
  "version": "0.2.0",
  "description": "A broadcast-ready countdown to today's stream start in local time, with an editable promo line.",
  "icon": "icon.svg",
  "entry": "main.ts",
  "ui": "ui/index.html",
  "window": { "width": 960, "height": 540, "title": "Stream Countdown" },
  "strictArgs": true,
  "commands": {
    "state": {
      "help": "where the countdown stands: phase, remaining ms, local now and target, settings",
      "returns": { "phase": "string", "remainingMs": "number", "timeZone": "string", "now": "object", "target": "object", "settings": "object" },
      "effect": "read"
    },
    "configure": {
      "help": "change the target (date YYYY-MM-DD, time HH:MM local) or the copy; every field is optional",
      "args": {
        "date": "string?",
        "time": "string?",
        "title": "string?",
        "liveText": "string?",
        "promoShow": "boolean?",
        "promoText": "string?",
        "promoUrl": "string?",
        "promoPrice": "string?",
        "promoWas": "string?"
      },
      "effect": "write"
    },
    "today": {
      "help": "point the countdown at today's local date, optionally at a new time HH:MM",
      "args": { "time": "string?" },
      "effect": "write"
    },
    "reset": {
      "help": "back to today 09:15 local and the default copy",
      "effect": "write"
    }
  },
  "palette": [
    {
      "title": "Countdown: set start time (stream-countdown)",
      "snippet": "await wm.apps[\"stream-countdown\"].today({ time: {time} })",
      "args": [{ "name": "time", "type": "string", "default": "\"09:15\"" }]
    }
  ],
  "permissions": {}
}
